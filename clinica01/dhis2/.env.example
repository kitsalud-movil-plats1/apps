# Copiar a .env (600) o dejar que lo genere el rol dhis2 de Ansible desde el vault.
# Directorio de datos en el disco de datos de la VM
DATOS=/srv/dhis2
DB_NAME=dhis2
DB_USERNAME=dhis
DB_PASSWORD=
# Subredes de la red de Docker de DHIS2 (las nombra pg_hba.conf)
RED4=172.30.0.0/24
RED6=fdc4:5a1d:7e20:1::/64
