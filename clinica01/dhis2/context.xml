<?xml version="1.0" encoding="UTF-8"?>
<!-- context.xml de Tomcat 10.1 de la imagen dhis2/core, con RemoteIpValve.
     Caddy (en el host) llega por la red de Docker y manda X-Forwarded-Proto,
     X-Forwarded-Port y X-Forwarded-For; así DHIS2 arma sus redirecciones con
     https y el puerto que usó el cliente, y registra su IP real. Solo se
     confía en la red de Docker y en lo. -->
<Context>
    <WatchedResource>WEB-INF/web.xml</WatchedResource>
    <WatchedResource>WEB-INF/tomcat-web.xml</WatchedResource>
    <WatchedResource>${catalina.base}/conf/web.xml</WatchedResource>

    <Valve className="org.apache.catalina.valves.RemoteIpValve"
           internalProxies="127\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2[0-9]|3[0-1])\.\d{1,3}\.\d{1,3}"
           remoteIpHeader="X-Forwarded-For"
           protocolHeader="X-Forwarded-Proto"
           portHeader="X-Forwarded-Port" />
</Context>
