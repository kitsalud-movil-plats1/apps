# Proxy inverso de comunidad01 (D-16). El contenido público va por HTTP y
# registro.salud.movil por HTTPS con la CA del kit.
{
	# La raíz no se instala en el sistema del contenedor
	skip_install_trust
	# Certificado para los clientes que llegan por IP y no mandan SNI
	default_sni registro.salud.movil
	# CA del kit (D-16, apps#3): firma con el intermedio de esta VM, que solo
	# vale para sus nombres; la llave de la raíz no está en la VM
	pki {
		ca local {
			name "Kit de salud movil"
			root {
				format pem_file
				cert /pki/raiz.crt
			}
			intermediate {
				format pem_file
				cert /pki/intermedio.crt
				key /pki/intermedio.key
			}
		}
	}
}

# Biblioteca Kiwix (apps#4)
http://biblioteca.salud.movil {
	reverse_proxy 127.0.0.1:8090
	log
}

# Raíz de la CA del kit para instalarla en los equipos (apps#3)
http://ca.salud.movil {
	root * /srv/publica
	@raiz path /raiz.crt
	header @raiz Content-Type application/x-x509-ca-cert
	file_server
	log
}

# Formularios de prerregistro (apps#6)
registro.salud.movil {
	tls internal
	reverse_proxy 127.0.0.1:8100
	log
}
